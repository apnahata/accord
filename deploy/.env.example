ACCORD_IMAGE=
ACCORD_DOMAIN=
# MongoDB Atlas (replica set required for transactions). Private constraints are AES-256-GCM encrypted with ACCORD_ENCRYPTION_KEY.
MONGODB_URI=
MONGODB_DB=accord
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes previously stored private constraints unreadable.
ACCORD_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Live stay search. LiteAPI: sandbox key (sand_... or sandbox_...) only. SerpApi: Google Hotels vacation rentals (search only).
LITEAPI_KEY=
SERPAPI_KEY=
TIGER_DATABASE_URL=
BACKBOARD_API_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=
ELEVENLABS_API_KEY=
