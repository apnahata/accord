{
  "name": "accord",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "frontend"],
  "scripts": {
    "dev:api": "tsx --env-file-if-exists=.env packages/server/src/server.ts",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test:core": "tsx --test packages/domain/test/*.test.ts packages/server/test/*.test.ts",
    "test:mongo": "tsx --env-file-if-exists=.env --test packages/server/test/mongo.test.ts",
    "check": "tsc --noEmit -p packages/domain/tsconfig.json && tsc --noEmit -p packages/server/tsconfig.json && npm run build -w frontend"
  },
  "devDependencies": { "tsx": "^4.20.6", "typescript": "^5.9.2", "@types/node": "^22.18.6" }
}
