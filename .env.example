# Copy to .env (gitignored) and fill in. `npm run dev:api` loads it automatically.

# Accord searches, replans, nudges and watches offers on its own. Set to "off" for fully manual solving.
# ACCORD_AUTOPILOT=off

# Gemini: private AI intake, listing summaries, and nearby-area suggestions when nothing fits. https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Live stay search. This build accepts LiteAPI sandbox keys only (sand_... or sandbox_...). SerpApi supplies Google Hotels vacation-rental search.
LITEAPI_KEY=
SERPAPI_KEY=

# MongoDB Atlas. Leave MONGODB_URI empty to keep state in memory only.
# Use your OWN database name when developing (e.g. accord_yourname): two running API servers must never share one database.
MONGODB_URI=
MONGODB_DB=accord
# 32 random bytes, base64. Everyone using the same database needs the same key, or stored private requirements can't be read.
ACCORD_ENCRYPTION_KEY=
# Tiger Data (TimescaleDB) connection string: price history, stability and the /pulse dashboard. Run `npm run migrate:tiger -w @accord/integrations` once.
TIGER_DATABASE_URL=
