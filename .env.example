# Copy to .env (gitignored) and fill in. `npm run dev:api` loads it automatically.

# Absolute URL used in generated invitation links and QR codes. For phone testing,
# use your LAN/tunnel URL instead of localhost (for example http://192.168.1.20:5173).
PUBLIC_APP_URL=http://localhost:5173

# Gemini: private AI intake and listing summaries. https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Nuitée Connect liteAPI Build: one sandbox key (sand_...) for hotel search, rates, prebook, and test booking.
LITEAPI_KEY=
# Optional comparison-only Google Hotels results; these cannot be auto-booked by Accord.
SERPAPI_KEY=

# CyberSource test gateway (Business Center TEST, Shared Secret key).
# Keep JWT unless diagnosing an account that was provisioned only for HTTP Signature.
CYBERSOURCE_AUTHENTICATION_TYPE=jwt
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_KEY_ID=
CYBERSOURCE_SECRET_KEY=
# Server-only sandbox funding instrument. Never use a real card here or commit .env.
CYBERSOURCE_TEST_CARD_NUMBER=4111111111111111
CYBERSOURCE_TEST_CARD_EXPIRY_MONTH=12
CYBERSOURCE_TEST_CARD_EXPIRY_YEAR=2031
CYBERSOURCE_TEST_CARD_SECURITY_CODE=123
# Optional but recommended: downloaded CyberSource sandbox MLE public certificate.
CYBERSOURCE_MLE_PUBLIC_CERT_PATH=
# Optional sandbox bill-to overrides; safe test defaults are used when blank.
CYBERSOURCE_TEST_BILL_TO_ADDRESS1=
CYBERSOURCE_TEST_BILL_TO_CITY=
CYBERSOURCE_TEST_BILL_TO_STATE=
CYBERSOURCE_TEST_BILL_TO_POSTAL_CODE=
CYBERSOURCE_TEST_BILL_TO_COUNTRY=
CYBERSOURCE_TEST_BILL_TO_EMAIL=
CYBERSOURCE_TEST_BILL_TO_PHONE=

# MongoDB Atlas. Leave MONGODB_URI empty to keep state in memory only.
# Use your OWN database name when developing (e.g. accord_yourname): two running API servers must never share one database.
MONGODB_URI=
MONGODB_DB=accord
# 32 random bytes, base64. Everyone using the same database needs the same key, or stored private requirements can't be read.
ACCORD_ENCRYPTION_KEY=
